# Credenciais do MT5 — copie este arquivo para ".env" (sem ".example") e preencha.
# ".env" já está no .gitignore: nunca é versionado, fica só na sua máquina.
#
# Tudo aqui é opcional. Se o terminal MT5 já estiver aberto e logado na conta/
# simulador que você quer usar, não precisa preencher nada — MT5Provider() se conecta
# nele sozinho. Só preencha se quiser login automático (ex. rodando sem abrir o MT5
# manualmente antes, ou numa tarefa agendada).

MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# Caminho do terminal64.exe, só se o MT5 não estiver na pasta padrão de instalação
# (ex.: C:\Program Files\<Sua Corretora>\terminal64.exe). Deixe em branco se não souber.
MT5_PATH=
